# PostgreSQL connection string — ЕДИНСТВЕННАЯ база проекта, ВСЕГДА Supabase
# Postgres (personal и corporate таблицы обе живут здесь, локального
# Docker/fallback-Postgres в проекте больше нет). Взять в Supabase: Project
# Settings -> Database -> Connection string (используйте "Session pooler"
# или прямое подключение, не "Transaction pooler" — приложению нужны
# обычные многошаговые транзакции с блокировкой строки для лимита ответов).
# Пароль в строке должен быть URL-encoded (спецсимволы вроде / или + -> %XX).
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Порт, на котором слушает API
PORT=4000

# Домен фронтенда, которому разрешён доступ (CORS). В деве можно "*".
WEB_ORIGIN="http://localhost:3000"

# --- Supabase (корпоративная часть) ---------------------------------------
# Project Settings -> API в Supabase Dashboard.
# SUPABASE_URL: "Project URL", например https://xxxxxxxx.supabase.co
SUPABASE_URL=""
# SUPABASE_SECRET_KEY: "service_role" secret key (НЕ anon/publishable!).
# Нужен бэкенду для двух вещей: (1) проверять JWT компании на защищённых
# /api/corporate/* роутах через supabase.auth.getUser(token), (2) админ-скрипт
# create-company создаёт пользователя Supabase Auth. Никогда не должен
# попасть во фронтенд/браузер/git.
SUPABASE_SECRET_KEY=""
