# URL бэкенд-API (apps/api). В деве обычно http://localhost:4000
VITE_API_BASE_URL="http://localhost:4000"

# --- Supabase (корпоративный login) ----------------------------------------
# Project Settings -> API в Supabase Dashboard. Оба значения ПУБЛИЧНЫЕ —
# безопасно попадают в собранный фронтенд-бандл (это обычный, ожидаемый
# режим работы anon/publishable key: доступ реально ограничивается Auth +
# RLS на стороне Supabase, а не секретностью этого ключа).
# VITE_SUPABASE_URL: "Project URL", например https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=""
# VITE_SUPABASE_PUBLISHABLE_KEY: "anon" / "publishable" key (НЕ service_role!).
VITE_SUPABASE_PUBLISHABLE_KEY=""
